{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information and personal app preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "defaultAiMode": { "type": "string", "maxLength": 64 },
        "dailyPromptsEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "Private user reflection or journal entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 100000 },
        "tags": { "type": "array" },
        "isFavorite": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "wordCount": { "type": "number" },
        "characterCount": { "type": "number" },
        "aiSummary": { "type": "string", "maxLength": 5000 },
        "aiKeyThemes": { "type": "array" },
        "aiActionItems": { "type": "array" },
        "mood": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "content"]
    },
    "Conversation": {
      "title": "AI Conversation",
      "description": "Multi-turn chat session with Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "mode": { "type": "string", "maxLength": 64 },
        "messageCount": { "type": "number" },
        "linkedEntryIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "mode"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Individual message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 50000 },
        "mode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "userId", "role", "content"]
    },
    "Goal": {
      "title": "Personal Goal",
      "description": "Actionable goal extracted from reflection or created by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "archived"] },
        "tasks": { "type": "array" },
        "sourceEntryId": { "type": "string", "maxLength": 128 },
        "targetDate": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status"]
    },
    "Insight": {
      "title": "AI Reflection Insight",
      "description": "Weekly, monthly, or thematic reflection insights",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "periodType": { "type": "string", "enum": ["weekly", "monthly", "custom"] },
        "periodKey": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "summary": { "type": "string", "maxLength": 10000 },
        "keyThemes": { "type": "array" },
        "whatWentWell": { "type": "array" },
        "challenges": { "type": "array" },
        "goalsIdentified": { "type": "array" },
        "suggestedNextSteps": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "periodType", "title", "summary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User's private journal reflections"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User's AI conversation threads"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside an AI conversation"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "User's actionable goals and task checklists"
    },
    "/users/{userId}/insights/{insightId}": {
      "schema": "Insight",
      "description": "AI-generated periodic insights and reflections"
    }
  }
}
